<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🗑️ WipeFiles"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnPick"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="📁 Choose Files to Wipe"
            android:textSize="16sp"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Overwrite passes:"
                android:textSize="16sp"
                android:gravity="center_vertical"/>

            <EditText
                android:id="@+id/editPasses"
                android:layout_width="80dp"
                android:layout_height="48dp"
                android:text="3"
                android:textAlignment="center"
                android:inputType="number"
                android:minHeight="48dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnWipe"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="☢️ WIPE FOREVER"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#D32F2F"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nothing selected — choose files first."
            android:textSize="14sp"
            android:textColor="#757575"
            android:textIsSelectable="true"
            android:paddingTop="8dp"/>
    </LinearLayout>
</ScrollView>
