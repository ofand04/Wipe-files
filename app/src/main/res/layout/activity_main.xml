<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080D0C"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FIELD SYSTEMS  /  DATA SECURITY"
            android:textColor="#78A895"
            android:textSize="11sp"
            android:letterSpacing="0.12"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WIPEFILES"
            android:textColor="#F0F5F1"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SECURE FILE DISPOSAL // ANDROID"
            android:textColor="#7D8B85"
            android:textSize="12sp"
            android:letterSpacing="0.06"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="22dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#121B18"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="01  /  TARGET FILES"
                android:textColor="#9FCBB7"
                android:textStyle="bold"
                android:textSize="13sp"
                android:letterSpacing="0.08"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnPick"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="SELECT FILES"
                android:textColor="#07110D"
                android:textStyle="bold"
                android:backgroundTint="#9FCBB7"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/selectedCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="00 FILE(S) QUEUED"
                android:textColor="#DDE8E1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/selectedFiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No files selected yet."
                android:textColor="#A8B5AE"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp"
                android:padding="12dp"
                android:background="#0B1210"
                android:textIsSelectable="true" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#121B18"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="02  /  WIPE PARAMETERS"
                android:textColor="#9FCBB7"
                android:textStyle="bold"
                android:textSize="13sp"
                android:letterSpacing="0.08"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Filename change attempts"
                android:textColor="#F0F5F1"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Attempt to rename the selected file before deletion (1–100). Provider support varies."
                android:textColor="#91A098"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/editNameChanges"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="#78A895"
                android:inputType="number"
                android:maxLength="3"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="10"
                android:textColor="#F0F5F1"
                android:textColorHint="#718078"
                android:textSize="18sp"
                android:selectAllOnFocus="true"
                android:hint="1–100" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2B3932"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Random-content overwrite passes"
                android:textColor="#F0F5F1"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Write random data over the file contents (1–10). More passes take longer and do not guarantee physical erasure on flash storage."
                android:textColor="#91A098"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/editContentPasses"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="#78A895"
                android:inputType="number"
                android:maxLength="2"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="3"
                android:textColor="#F0F5F1"
                android:textColorHint="#718078"
                android:textSize="18sp"
                android:selectAllOnFocus="true"
                android:hint="1–10" />
        </LinearLayout>

        <Button
            android:id="@+id/btnWipe"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="CONFIRM &amp; WIPE"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:letterSpacing="0.05"
            android:backgroundTint="#8E3C35"
            android:layout_marginBottom="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#121B18">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OPERATION LOG"
                android:textColor="#9FCBB7"
                android:textStyle="bold"
                android:textSize="12sp"
                android:letterSpacing="0.08"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="READY // Waiting for file selection"
                android:textColor="#DDE8E1"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp"
                android:textIsSelectable="true" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BEST-EFFORT ONLY  ·  STORAGE PROVIDERS AND FLASH MEMORY LIMIT ERASURE GUARANTEES"
            android:textColor="#718078"
            android:textSize="10sp"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:lineSpacingExtra="3dp"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp" />

    </LinearLayout>
</ScrollView>
