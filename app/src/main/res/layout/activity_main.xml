<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080D0C"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="WIPEFILES"
            android:textColor="#F0F5F1"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="AES-256 encrypted wipe"
            android:textColor="#91A098"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="#121B18"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="SELECT FILES"
                android:textColor="#9FCBB7"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPick"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:backgroundTint="#9FCBB7"
                android:text="SELECT FILES"
                android:textColor="#07110D"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPickFolder"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#9FCBB7"
                android:text="SELECT FOLDER"
                android:textColor="#07110D"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/selectedCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="00 FILE(S) SELECTED"
                android:textColor="#DDE8E1"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/selectedFiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#0B1210"
                android:padding="12dp"
                android:lineSpacingExtra="5dp"
                android:text="No files selected."
                android:textColor="#A8B5AE"
                android:textIsSelectable="true"
                android:textSize="14sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:background="#121B18"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="SETTINGS"
                android:textColor="#9FCBB7"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Filename change attempts (1–100)"
                android:textColor="#F0F5F1"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editNameChanges"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="#78A895"
                android:inputType="number"
                android:maxLength="3"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:selectAllOnFocus="true"
                android:text="10"
                android:textColor="#F0F5F1"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Random overwrite passes (1–100)"
                android:textColor="#F0F5F1"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editContentPasses"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="#78A895"
                android:inputType="number"
                android:maxLength="3"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:selectAllOnFocus="true"
                android:text="3"
                android:textColor="#F0F5F1"
                android:textSize="18sp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnWipe"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="10dp"
            android:backgroundTint="#8E3C35"
            android:text="CONFIRM &amp; WIPE"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="14dp"
            android:backgroundTint="#46534C"
            android:text="CANCEL OPERATION"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#121B18"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="LIVE PROGRESS"
                android:textColor="#9FCBB7"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/stage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="READY"
                android:textColor="#F0F5F1"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginBottom="12dp"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="#2B3932"
                android:progressTint="#9FCBB7" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="Select files, review settings, then confirm."
                android:textColor="#DDE8E1"
                android:textIsSelectable="true"
                android:textSize="13sp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
